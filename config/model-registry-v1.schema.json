{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cvs.local/schemas/model-registry-v1.schema.json",
  "title": "CVS Model Registry v1",
  "type": "object",
  "required": ["schema_version", "revisions", "defaults", "events"],
  "properties": {
    "schema_version": {"const": 1},
    "revisions": {"type": "object", "additionalProperties": {"$ref": "#/$defs/revision"}},
    "defaults": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^rev-[0-9a-f]{64}$"}},
    "events": {"type": "array", "items": {"type": "object", "required": ["event_id", "created_at", "action", "revision_id"]}}
  },
  "$defs": {
    "artifact": {"type": "object", "required": ["kind", "relative_path", "size", "sha256"], "properties": {"kind": {"enum": ["gpt", "sovits"]}, "relative_path": {"type": "string"}, "size": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "revision": {"type": "object", "required": ["revision_id", "engine", "root_id", "layout", "name", "discovery_key", "artifacts", "lifecycle", "availability", "registered_at"], "properties": {"revision_id": {"type": "string", "pattern": "^rev-[0-9a-f]{64}$"}, "engine": {"type": "string"}, "root_id": {"type": "string"}, "layout": {"type": "string"}, "name": {"type": "string"}, "discovery_key": {"type": "string"}, "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}, "character_id": {"type": ["string", "null"]}, "model_id": {"type": ["string", "null"]}, "target_language": {"type": "string"}, "profile_model_id": {"type": ["string", "null"]}, "scope": {"type": ["string", "null"]}, "lifecycle": {"enum": ["candidate", "default", "retired"]}, "availability": {"enum": ["unknown", "available", "missing", "invalid", "engine_unavailable"]}}}
  }
}

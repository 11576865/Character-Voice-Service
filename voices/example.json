{
  "schema_version": 2,
  "name": "Example Character",
  "target_language": "en",
  "default_model": "v2pro-main",
  "models": {
    "v2pro-main": {
      "name": "Main v2Pro model",
      "engine": "gpt-sovits",
      "version": "v2pro",
      "gpt_weights": "C:/path/to/example-e15.ckpt",
      "sovits_weights": "C:/path/to/example_e8_s96.pth"
    }
  },
  "default_reference": "default",
  "references": {
    "default": {
      "name": "Default reference",
      "audio": "C:/path/to/reference.wav",
      "text": "The exact sentence spoken in the reference audio.",
      "language": "en",
      "emotion": "neutral",
      "intensity": 0.5,
      "quality": "good"
    }
  },
  "parameters": {
    "top_k": 15,
    "top_p": 1.0,
    "temperature": 1.0,
    "text_split_method": "cut5",
    "batch_size": 1,
    "batch_threshold": 0.75,
    "split_bucket": true,
    "fragment_interval": 0.3,
    "seed": -1,
    "parallel_infer": true,
    "repetition_penalty": 1.35,
    "sample_steps": 32,
    "super_sampling": false,
    "overlap_length": 2,
    "min_chunk_length": 16
  }
}
